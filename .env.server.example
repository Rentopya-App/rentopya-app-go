# GENERATED from deploy/env/schema by `scripts/prod-env.sh example`. Do not edit by hand.
# Production key list. Create the real file (asks only for the app URL, generates every secret):
#   make prod-env      (scripts/prod-env.sh init -o .env.server)   then: make prod-config && make prod-up
# Existing deployment: make prod-env-upgrade   verify: make prod-env-check
# Values are examples for https://app.example.com; secrets stay blank on purpose.
# Keys not listed keep their compose.prod.yml defaults (all documented in .env.example).
ENV_SCHEMA_VERSION=11

# --- Identity / Docker ---
NAME_PREFIX=rentopia
BACKEND_IMAGE=rentopia-backend:latest
FRONTEND_IMAGE=rentopia-frontend:latest
SITE_IMAGE=rentopia-site:latest

# --- Public URLs (from APP_URL) ---
APP_URL=https://app.example.com
REALTIME_HOST=realtime.app.example.com
AUTH_URL=https://app.example.com
PUBLIC_FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CENTRIFUGO_ALLOWED_ORIGINS=https://app.example.com
CENTRIFUGO_WS_URL=wss://realtime.app.example.com/connection/websocket
NEXT_PUBLIC_CENTRIFUGO_URL=wss://realtime.app.example.com/connection/websocket
AUTH_WEBAUTHN_RP_ID=app.example.com
# Branded site (TEC-729): {subdomain}.{APP_HOST}; route *.{APP_HOST} to the site service.
SITE_BASE_URL=https://app.example.com

# --- Database / cache / search ---
DB_USER=rentopia
DB_NAME=rentopia
# secret: generated by init (alnum, 32 chars)
DB_PASSWORD=
# secret: generated by init (alnum, 32 chars)
REDIS_PASSWORD=
# secret: generated by init (hex, 32 bytes)
MEILI_MASTER_KEY=

# --- Object storage (SeaweedFS S3) ---
S3_BUCKET=rentopia
# secret: generated by init (alnum, 20 chars)
S3_ACCESS_KEY=
# secret: generated by init (alnum, 40 chars)
S3_SECRET_KEY=

# --- Auth / crypto ---
# secret: generated by init (hex, 32 bytes)
JWT_ACCESS_SECRET=
# secret: generated by init (hex, 32 bytes)
JWT_REFRESH_SECRET=
# secret: generated by init (hex, 32 bytes)
AUTH_SECRET=
# secret: generated by init (hex, 32 bytes)
AUTH_ADAPTER_SECRET=
# secret: generated by init (b64, 32 bytes)
APP_ENCRYPTION_KEY=
# secret: generated by init (hex, 32 bytes)
SITE_EMBED_SECRET=
# secret: generated by init (hex, 24 bytes)
CENTRIFUGO_API_KEY=
# secret: generated by init (hex, 32 bytes)
CENTRIFUGO_TOKEN_HMAC_SECRET=

# --- Web Push ---
# VAPID public key: generated by init with its pair
VAPID_PUBLIC_KEY=
# VAPID private key: generated by init with its pair
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@app.example.com

# --- Product ---
TENANCY_ENABLED=true
TENANCY_SELF_SERVE=false
LOG_LEVEL=info
# TEC-744: development | staging | production. A staging stack sets staging:
# the official KABİS / e-invoice / Netgsm endpoints are then refused unless the
# *_ALLOW_PRODUCTION_IN_NON_PROD key below is true (ignored in production).
APP_ENV=production

# --- Mail (fill in to send e-mail) ---
MAIL_FROM=noreply@app.example.com
MAIL_FROM_NAME=Rentopya
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Error tracking (optional) ---
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
# TEC-744: the site's DSN; SENTRY_ENVIRONMENT empty = APP_ENV.
SITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Share of backend HTTP requests sent as performance transactions (0 = off).
SENTRY_TRACES_SAMPLE_RATE=0

# --- Payments (TEC-707; merchant keys are per organization, in the panel) ---
IYZICO_SANDBOX_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_LIVE_BASE_URL=https://api.iyzipay.com

# --- SMS (TEC-734; Netgsm credentials are per organization, in the panel) ---
# Netgsm has no sandbox: leave the sandbox URL empty in production (sandbox
# accounts then refuse to send). SMS_LOG_PROVIDER is ignored in production.
NETGSM_LIVE_BASE_URL=https://api.netgsm.com.tr
NETGSM_SANDBOX_BASE_URL=
SMS_LOG_PROVIDER=false

# --- Production guard (TEC-744, docs/operations/observability.md) ---
KABIS_ALLOW_PRODUCTION_IN_NON_PROD=false
EINVOICE_ALLOW_PRODUCTION_IN_NON_PROD=false
NETGSM_ALLOW_PRODUCTION_IN_NON_PROD=false

# --- Failed-work alerts (TEC-744): e-mail copy of the in-app alerts (optional) ---
ALERT_EMAIL=

# --- WhatsApp (TEC-735; wuzapi on the private app network, one session per organization) ---
# Organizations link their own number in the panel (QR). Pin WUZAPI_IMAGE to a
# tested tag; the admin token creates the per-organization wuzapi users.
WUZAPI_IMAGE=asternic/wuzapi:latest
# secret: generated by init (hex, 32 bytes)
WUZAPI_ADMIN_TOKEN=
# secret: generated by init (alnum, 32 chars)
WUZAPI_ENCRYPTION_KEY=
# Device name shown in the linked-devices list of each organization's phone.
WUZAPI_DEVICE_NAME=Rentopya

# --- Verified custom site domains (TEC-731) ---
SITE_DOMAIN_TARGET_HOST=
SITE_DOMAIN_TARGET_IPS=
SITE_DOMAIN_PROVISIONER=manual
SITE_DOMAIN_TRAEFIK_DIR=/app/site-domains
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_COMPOSE_ID=
DOKPLOY_SITE_SERVICE=site
DOKPLOY_SITE_PORT=3000
APP_NETWORK_NAME=

# --- Backups (TEC-741, docs/operations/backup-restore.md) ---
# COMPOSE_PROFILES=backup starts the scheduled `backup` service. Fill in
# BACKUP_AGE_RECIPIENT (age public key, `age-keygen`, private key kept off
# the server) before enabling it. Off-site copy runs when BACKUP_OFFSITE_BUCKET is set.
COMPOSE_PROFILES=
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/rentopia
BACKUP_TIME=03:15
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_REGION=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=

# --- Mobile app (all optional; empty = feature off) ---
# AUTH_REVIEW_ACCOUNTS=email:code,... fixed sign-in codes for App Store / Play review.
AUTH_REVIEW_ACCOUNTS=
AUTH_APPLE_NATIVE_CLIENT_IDS=
AUTH_GOOGLE_NATIVE_CLIENT_IDS=
# Sign in with Apple key fallback; prefer uploading the .p8 in Platform → Integrations → Apple.
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
# QR sign-in location: trust edge geo headers only behind Cloudflare; optional GeoLite2 .mmdb path.
AUTH_QR_TRUST_GEO_HEADERS=false
AUTH_QR_GEOIP_DB=
# Expo Push Service token (only with Expo "enhanced push security").
EXPO_ACCESS_TOKEN=
