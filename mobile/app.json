{
  "expo": {
    "name": "Rentopya",
    "slug": "rentopya",
    "owner": "furkanmeclis",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentopya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rentopya.app",
      "appleTeamId": "N5T7KH96U3",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.rentopya.app",
      "adaptiveIcon": {
        "backgroundColor": "#2E358C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "tr": "./assets/locales/tr.json",
      "en": "./assets/locales/en.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#020618",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "tr",
            "en"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Rentopya uses the camera to scan vehicle QR labels and plates.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
