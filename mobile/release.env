# Store release values: the one list that the GitHub release workflow
# (scripts/ci/mobile-release.sh), the EAS "production" environment and Xcode
# Cloud (ci_scripts/ci_post_clone.sh) must agree on. Anything here that ends
# up in the app config changes the native fingerprint, so a value that differs
# between them means OTA updates never reach the build.
#
# Plain KEY=VALUE lines, no quotes, no secrets (the file is committed).
# The release script refuses to ship unless the EAS "production" environment
# holds exactly these values (an empty value here = unset there), plus an
# https:// EXPO_PUBLIC_API_URL. ci_post_clone.sh exports them for prebuild and
# the JS bundle. Change a value here and in EAS in the same step; it needs a
# new store build on both platforms. Docs: mobile/docs/OTA.md.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_MODE=live
# Native sign-in switches (app.config.js): both change the iOS project.
EXPO_PUBLIC_APPLE_SIGN_IN=1
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=442117577782-h31lau8bobgqmv1l8gli5f3dgrsbcrs0.apps.googleusercontent.com
