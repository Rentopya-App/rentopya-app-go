{
  "name": "rentopya-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ../backend/docs/openapi.yaml -o src/core/api/schema.d.ts",
    "api:check": "node scripts/check-api.mjs",
    "permissions:gen": "node scripts/gen-permissions.mjs",
    "i18n:gen": "node scripts/gen-i18n-resources.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "icons:gen": "node scripts/gen-material-symbols.mjs",
    "uniwind:types": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
    "doctor": "expo-doctor",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~58.0.27",
    "@tanstack/query-async-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.4.5",
    "lucide-react-native": "^1.57.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-nitro-google-signin": "^2.3.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "openapi-typescript": "7.13.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
