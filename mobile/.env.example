# Origin of the Go API; the app calls <origin>/v1/... with a Bearer token (no Next.js passthrough).
# Simulator / emulator on this machine: http://localhost:8080 (Android emulator: http://10.0.2.2:8080)
# Device on the LAN:                    http://<LAN IP of your computer>:8080
# Production:                           https://<api host>
EXPO_PUBLIC_API_URL=http://localhost:8080
# Panel origin, for links that open the web (forgot password, settings).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Native sign-in (optional; unset = button hidden). The API must list the same ids:
# AUTH_APPLE_NATIVE_CLIENT_IDS (bundle id com.rentopya.app) and AUTH_GOOGLE_NATIVE_CLIENT_IDS.
# EXPO_PUBLIC_APPLE_SIGN_IN=1
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web client id>.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios client id>.apps.googleusercontent.com
